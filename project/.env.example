# ──────────────────────────────────────────────
# AFAB Backend — Environment Variables (EXAMPLE)
# Copy this file to .env and fill in real values.
# NEVER commit .env or real credentials to Git!
# ──────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=afab
POSTGRES_USER=afab_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ── Spring Boot App ──────────────────────────
# Use "local" for local development, "prod" for production
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── JWT & Cookie Security ────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_BASE64_ENCODED_256_BIT_OR_LONGER_SECRET
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
# Production MUST use AFAB_COOKIE_SECURE=true
AFAB_COOKIE_SECURE=false
AFAB_COOKIE_SAME_SITE=Lax
# NEVER enable in production
AFAB_ALLOW_DEV_OTP=false
# Comma-separated trusted reverse proxy IPs/CIDRs for X-Forwarded-For (empty = use remoteAddr)
AFAB_TRUSTED_PROXIES=

# ── MinIO / S3 Private Receipt Storage ───────
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=afab-receipts
AFAB_RECEIPT_MAX_SIZE_BYTES=10485760
AFAB_RECEIPT_PRESIGN_EXPIRY_SECONDS=300

# ── Mail (SMTP) ──────────────────────────────
# NEVER commit real SMTP credentials or App Passwords.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_SMTP_USERNAME
MAIL_PASSWORD=CHANGE_ME_SMTP_APP_PASSWORD
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=AFAB
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

# ── Redis (Distributed Rate Limiting & Cache) ─
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Rate limit behavior on Redis outage: fail_closed (recommended in prod) or fail_open
AFAB_RATE_LIMIT_FAIL_MODE=fail_closed

# ── Stripe Billing (Sandbox / Test Mode) ─────
# Keep real keys ONLY in untracked project/.env — never commit real keys here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=bpc_1Ueknz38YkKVFSSmHl6ImMe7

# ── AFAB AI Copilot (Local Ollama + pgvector RAG) ──
OLLAMA_BASE_URL=http://host.docker.internal:11434
AFAB_AI_ENABLED=true
AFAB_AI_CHAT_MODEL=gemma4:e4b
AFAB_AI_EMBED_MODEL=embeddinggemma-2:270m
AFAB_AI_NUM_CTX=4096
AFAB_AI_MAX_OUTPUT_TOKENS=1024
AFAB_AI_MAX_TOOL_CALLS=4
AFAB_AI_MAX_CONCURRENT=1
AFAB_AI_TIMEOUT_SECONDS=90
