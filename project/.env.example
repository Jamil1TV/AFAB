# ──────────────────────────────────────────────
# AFAB Backend — Environment Variables (EXAMPLE)
# Copy this file as .env and fill in your values
# ──────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=afab
POSTGRES_USER=afab_user
POSTGRES_PASSWORD=afab_secret_2026

# ── Spring Boot App ──────────────────────────
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ── JWT ──────────────────────────────────────
JWT_SECRET=b3BlbnNlc2FtZS1hZmFiLXN1cGVyLXNlY3JldC1rZXktMjAyNi1qd3QtdG9rZW4tc2lnbmluZy1rZXk=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ── MinIO (S3-Compatible Storage) ────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=afab_minio_access
MINIO_SECRET_KEY=afab_minio_secret_2026
MINIO_BUCKET=afab-receipts

# ── Mail (Gmail SMTP for local dev) ──────────
# ⚠️ NEVER commit real credentials. This repo is PUBLIC — Google automatically
#    revokes App Passwords that appear on GitHub, which breaks verification emails.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
# Use an "App Password" (https://myaccount.google.com/apppasswords), NOT your real password.
# Requires 2-Step Verification on the account. 16 letters, spaces optional.
MAIL_PASSWORD=your-16-letter-app-password
# Must be the same as MAIL_USERNAME (or a verified "Send mail as" alias) for Gmail.
MAIL_FROM=your-account@gmail.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

# ── Redis (Optional Cache) ───────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
